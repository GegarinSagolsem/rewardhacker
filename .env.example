# Copy to .env (git-ignored) and fill in. Never commit real keys.
GEMINI_API_KEY=
# Day 6 backend (free tiers): Neon Postgres + MongoDB Atlas
DATABASE_URL=
MONGODB_URI=
# Random string, 32+ chars, signs login tokens. Generate one:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
RH_JWT_SECRET=
# Optional: RH_STORAGE_DIR (uploaded tasks, default ~/.rewardhacker/tasks), RH_CORS_ORIGINS,
#           RH_MONGODB_DB, RH_TOKEN_TTL_MINUTES, RH_MAX_UPLOAD_MB
# Optional overrides
# RH_MODEL=gemini-3.1-flash-lite
# RH_DAILY_BUDGET_USD=0.50
# RH_RUN_BUDGET_USD=0.05
# RH_ADVERSARY_MAX_STEPS=15
# RH_DISABLE_LLM=1
